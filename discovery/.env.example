# ---------------------------------------------------------------------------
# rdx — agentic resource discovery
#
# Phase 1 uses only unauthenticated public endpoints, so there are NO secrets
# here yet. Keys below are feature flags. Real credentials arrive in Phase 2
# (Smithery API key, optional GitHub PAT for higher search rate limits).
# ---------------------------------------------------------------------------

# --- Kill switches -------------------------------------------------------
# Set to 1 to make the UserPromptSubmit hook a no-op without uninstalling it.
# The file ~/.claude/rdx/DISABLED does the same thing and takes precedence.
RDX_DISABLE=0

# Shadow mode: evaluate the gate and log every decision, but never inject.
# Phase 1a runs this way until thresholds are calibrated by `rdx eval --gate`.
RDX_SHADOW=1

# --- Gate thresholds -----------------------------------------------------
# Unset means +inf, i.e. the gate never fires. Set these from the histogram
# that `rdx eval --gate` prints. Do not guess them.
# RDX_MIN_SCORE=0.45
# RDX_MIN_MARGIN=0.12

# --- Paths ---------------------------------------------------------------
# Override where the index and logs live (default: ~/.claude/rdx).
# RDX_STATE_DIR=

# --- Phase 2 (not yet used) ----------------------------------------------
# GITHUB_TOKEN=
# SMITHERY_API_KEY=
