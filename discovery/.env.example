# ---------------------------------------------------------------------------
# rdx — agentic resource discovery
#
# Phase 1 uses only unauthenticated public endpoints, so there are NO secrets
# here yet. Keys below are feature flags. Real credentials arrive in Phase 2
# (Smithery API key, optional GitHub PAT for higher search rate limits).
# ---------------------------------------------------------------------------

# --- Kill switches -------------------------------------------------------
# Set to 1 to make the UserPromptSubmit hook a no-op without uninstalling it.
# The file ~/.claude/rdx/DISABLED does the same thing and takes precedence.
RDX_DISABLE=0

# Shadow mode: evaluate the gate and log every decision, but never inject.
# ON BY DEFAULT, including when this variable is unset - forgetting it can
# never silently go live. Set to 0 when you are ready to see suggestions.
RDX_SHADOW=1

# --- Gate thresholds -----------------------------------------------------
# Shipped defaults, derived by sweeping a 68-case labelled corpus
# (corpora/gate.starter.yaml) against a real 3,980-resource index:
#
#   0.55 -> precision 0.82, recall 0.90
#   0.60 -> precision 1.00, recall 0.70   <- default
#   0.65 -> precision 1.00, recall 0.50
#
# Lower for more suggestions, raise for fewer. Replace these with numbers from
# YOUR history: `rdx mine`, label, then `rdx eval --gate`.
# RDX_MIN_SCORE=0.60
# RDX_MIN_MARGIN=0.0

# --- Paths ---------------------------------------------------------------
# Override where the index and logs live (default: ~/.claude/rdx).
# RDX_STATE_DIR=

# --- Phase 2 (not yet used) ----------------------------------------------
# GITHUB_TOKEN=
# SMITHERY_API_KEY=
