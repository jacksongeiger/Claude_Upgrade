{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "__REPO_DIR__/hooks/session-start.sh",
            "async": false
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__REPO_DIR__/hooks/resource-suggest.sh",
            "async": false,
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__REPO_DIR__/hooks/tool-observe.sh",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
